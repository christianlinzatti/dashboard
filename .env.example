# Spotify-Developer-App (ab Meilenstein 2)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# optional: feste Callback-URL (Standard: <aktuelle Domain>/api/auth/callback)
SPOTIFY_REDIRECT_URI=
# Zufälliger Schlüssel (mind. 32 Zeichen) zum Verschlüsseln des Session-Cookies
SESSION_SECRET=
# Kommagetrennte Spotify-User-IDs, die das Dashboard nutzen dürfen
ALLOWED_SPOTIFY_USERS=
# Upstash Redis (Vercel Marketplace) – Cache für Song-Kontext
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Inoffizielle Lyrics-Quellen (ab Meilenstein 3/6)
# Spotify Color-Lyrics: sp_dc-Cookie aus open.spotify.com (Browser → Entwicklertools → Cookies)
SPOTIFY_SP_DC=
# TOTP-Secret (Zahlenfolge als JSON-Array) und Version – ändert Spotify regelmäßig
SPOTIFY_TOTP_SECRET=
SPOTIFY_TOTP_VERSION=
# Reihenfolge egal (Ranking: Wort-Sync > Zeilen-Sync); nicht konfigurierte Provider werden übersprungen
LYRICS_PROVIDERS=musixmatch-desktop,spotify-color,netease,lrclib
# Stufe 5: Persönliches & Konzerte
LASTFM_API_KEY=
LASTFM_USER=
# oeticket (ohne Key) ist aktiv; 0 = aus
OETICKET=1
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=
SETLISTFM_API_KEY=
# Genius: Client Access Token (genius.com/api-clients) – Trivia: Produzenten, Songwriter, Samples
GENIUS_ACCESS_TOKEN=
# Flickr: Konzertfotos (alle Lizenzen, mit Fotograf/Lizenz), Key unter flickr.com/services/apps/create
FLICKR_API_KEY=
# TheAudioDB: leer = öffentlicher Test-Key; eigener Key (Patreon) für mehr Anfragen; 0 = aus
THEAUDIODB_API_KEY=
# Konzert-Umkreis: Heimatort (Name + Koordinaten) und Radius in km
HOME_LOCATION=Wien
HOME_LAT=48.2082
HOME_LON=16.3738
CONCERT_RADIUS_KM=200
# Stufe 3: Alexa-Skill (siehe alexa/README.md)
ALEXA_SKILL_ID=
# optional, Standard: erster Eintrag in ALLOWED_SPOTIFY_USERS
ALEXA_SPOTIFY_USER=
# optional: Adresse der Pi-Bridge (Standard ws://127.0.0.1:8787)
NEXT_PUBLIC_BRIDGE_URL=
# Stufe 4: optional Kontakt (z. B. E-Mail) im User-Agent für MusicBrainz/Wikimedia – weniger Drosselung
INFO_CONTACT=

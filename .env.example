# Spotify-Developer-App (ab Meilenstein 2)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# optional: feste Callback-URL (Standard: <aktuelle Domain>/api/auth/callback)
SPOTIFY_REDIRECT_URI=
# Zufälliger Schlüssel (mind. 32 Zeichen) zum Verschlüsseln des Session-Cookies
SESSION_SECRET=
# Kommagetrennte Spotify-User-IDs, die das Dashboard nutzen dürfen
ALLOWED_SPOTIFY_USERS=
# Upstash Redis (Vercel Marketplace) – Cache für Song-Kontext
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Inoffizielle Lyrics-Quellen (ab Meilenstein 3/6)
# Spotify Color-Lyrics: sp_dc-Cookie aus open.spotify.com (Browser → Entwicklertools → Cookies)
SPOTIFY_SP_DC=
# TOTP-Secret (Zahlenfolge als JSON-Array) und Version – ändert Spotify regelmäßig
SPOTIFY_TOTP_SECRET=
SPOTIFY_TOTP_VERSION=
# Dieselben Zugangsdaten schalten auch Spotify Canvas frei (Einstellung „Canvas“ im Dashboard).
# Reihenfolge egal (Ranking: Wort-Sync > Zeilen-Sync); nicht konfigurierte Provider werden übersprungen
LYRICS_PROVIDERS=better-lyrics,musixmatch-desktop,spotify-color,netease,lrclib
# optional: Better Lyrics (lyrics-api.boidu.dev) – ohne Key nur bereits gecachte Songs
BETTER_LYRICS_API_KEY=
# Stufe 5: Persönliches & Konzerte
LASTFM_API_KEY=
LASTFM_USER=
# oeticket und Eventim Deutschland (ohne Key) sind aktiv; 0 = aus
OETICKET=1
EVENTIM_DE=1
TICKETMASTER_API_KEY=
# Bandsintown vergibt App-IDs nur noch an Künstler und Partner – als Privatnutzer leer lassen (Quelle ist dann aus)
BANDSINTOWN_APP_ID=
SETLISTFM_API_KEY=
# Genius: Client Access Token (genius.com/api-clients) – Trivia: Produzenten, Songwriter, Samples
GENIUS_ACCESS_TOKEN=
# Flickr: Konzertfotos (alle Lizenzen, mit Fotograf/Lizenz), Key unter flickr.com/services/apps/create
# Neue API-Keys vergibt Flickr nur noch an Pro-Konten – ohne Key bleibt die Quelle aus (Fotos: Commons, TheAudioDB)
FLICKR_API_KEY=
# Show-Regie mit KI (optional): Claude schreibt je Song eine Regieanweisung (Bühne, Stimmung, Effekte je Abschnitt).
# Ohne Key läuft die Show mit den eingebauten Regeln. Key: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Alternativ OpenAI (wird genutzt, wenn kein ANTHROPIC_API_KEY gesetzt ist): platform.openai.com → API keys
OPENAI_API_KEY=
# Anbieter fest wählen, wenn beide Schlüssel gesetzt sind: anthropic | openai (leer = Claude zuerst)
SHOW_AI_PROVIDER=
# Modell für die Regie (leer = claude-opus-5-5 bzw. gpt-5.4-mini; günstiger bei Claude: claude-haiku-5-5).
# Ein Aufruf je Song, 30 Tage gecacht.
SHOW_AI_MODEL=
# TheAudioDB: leer = öffentlicher Test-Key; eigener Key (Patreon) für mehr Anfragen; 0 = aus
THEAUDIODB_API_KEY=
# Konzert-Umkreis: Heimatort (Name + Koordinaten) und Radius in km
HOME_LOCATION=Wien
HOME_LAT=48.2082
HOME_LON=16.3738
CONCERT_RADIUS_KM=200
# Orte ohne Koordinaten über OpenStreetMap (Nominatim) verorten; 0 = aus
CONCERT_GEOCODING=1
# Stufe 3: Alexa-Skill (siehe alexa/README.md)
ALEXA_SKILL_ID=
# optional, Standard: erster Eintrag in ALLOWED_SPOTIFY_USERS
ALEXA_SPOTIFY_USER=
# optional: Adresse der Pi-Bridge (Standard ws://127.0.0.1:8787)
NEXT_PUBLIC_BRIDGE_URL=
# Stufe 4: optional Kontakt (z. B. E-Mail) im User-Agent für MusicBrainz/Wikimedia – weniger Drosselung
INFO_CONTACT=

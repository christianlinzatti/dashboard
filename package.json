{
  "name": "sonic-stage",
  "version": "0.1.0",
  "private": true,
  "description": "Lyric-Dashboard mit Spotify, Wort-für-Wort-Lyrics und tanzenden 3D-Avataren",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/optimize-avatars.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "e2e:update": "playwright test --trace off --update-snapshots=all",
    "avatars": "node scripts/optimize-avatars.mjs",
    "mixamo": "tsx --no-deprecation scripts/mixamo/convert.ts",
    "mesh2motion": "tsx --no-deprecation scripts/mixamo/fetch-mesh2motion.ts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bridge": "node bridge/main.ts",
    "bridge:setup": "node bridge/setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "next": "^16.4.6",
    "openai": "^7.57.0",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
